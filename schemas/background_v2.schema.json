{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current insulator symmetry characters",
  "description": "rho is the circle action, s is antiunitarity, and r is charge reversal. Implementations additionally enforce r=rho XOR s and equal character-array lengths.",
  "type": "object",
  "required": ["s", "r"],
  "properties": {
    "schema_version": {"const": 2, "default": 2},
    "s": {"$ref": "#/$defs/character"},
    "r": {"$ref": "#/$defs/character"},
    "rho": {"$ref": "#/$defs/character"},
    "circle_action": {"$ref": "#/$defs/character"}
  },
  "$defs": {
    "character": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "enum": [0, 1]}
    }
  },
  "additionalProperties": true
}
